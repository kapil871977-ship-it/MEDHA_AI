# Copy this file to .env and fill in your own keys. Do NOT commit .env.
#
# At least one LLM key is required. OpenAI is the PRIMARY provider; Gemini is
# used as the fallback when OpenAI is unset or its call fails.

# OpenAI API key (primary LLM provider, gpt-4o-mini)
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API key (fallback provider).
# The model is auto-selected: the app tries its preference list and skips any
# model this key cannot use. Which models a key may use depends on when it was
# issued — keys created recently are granted only current-generation models and
# return 404 for the whole Gemini 2.x family. GET /health reports the model
# actually in use plus the last provider error.
GOOGLE_API_KEY=your_google_gemini_api_key_here

# ─── Timeouts ────────────────────────────────────────────────────────────────
# Seconds. Keep these BELOW the frontend's own request timeouts (90s for most
# calls, 105s for /kundli-analysis) or the browser aborts before the server
# answers and the user only ever sees the fallback text.
# A full Hindi kundli measures ~70s on a current Flash model, so 90s here.
MODEL_TIMEOUT_SECONDS=75
KUNDLI_MODEL_TIMEOUT_SECONDS=90

# Optional: override the OpenAI model (default gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# ─── Server ──────────────────────────────────────────────────────────────────
# Bind host (default 0.0.0.0 so cloud hosts can reach it; 127.0.0.1 = local only)
HOST=0.0.0.0

# Backend port (default 8010; the frontend expects 8010 unless REACT_APP_API_URL is set)
PORT=8010

# ─── Authentication ──────────────────────────────────────────────────────────
# Where the SQLite user + saved-report database lives. Point this at a
# persistent disk in production (e.g. /var/data/users.db on Render) so accounts
# and saved kundli reports survive redeploys.
AUTH_DB_PATH=

# Auth token signing secret. Set a long random value so users stay logged in
# across server restarts. If unset, a random per-process secret is used.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET_KEY=

# Auth token lifetime in seconds (default 2592000 = 30 days)
AUTH_TOKEN_TTL_SECONDS=2592000

# Require a valid bearer token on the astrology/market endpoints.
# true (default) = protected; false = anonymous access allowed (local testing).
AUTH_ENFORCE=true

# ─── Abuse protection ────────────────────────────────────────────────────────
# Comma-separated CORS allow-list. Defaults to "*" for development —
# set this to your real frontend origin(s) in production.
# e.g. ALLOWED_ORIGINS=https://fortune-guru.vercel.app
ALLOWED_ORIGINS=*

# Max requests per client IP per minute on the heavy endpoints (0 disables)
RATE_LIMIT_PER_MINUTE=30

# Max requests per client IP per minute on /auth/login and /auth/signup.
# Keep this low — it is what stops password brute-forcing. (0 disables)
AUTH_RATE_LIMIT_PER_MINUTE=10

# ─── Saved reports ───────────────────────────────────────────────────────────
# How many kundli readings to keep per account (oldest are pruned).
KUNDLI_HISTORY_LIMIT=20
