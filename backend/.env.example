# Copy this file to .env and fill in your own keys. Do NOT commit .env.

# Google Gemini API key (primary LLM provider) - required
GOOGLE_API_KEY=your_google_gemini_api_key_here

# OpenAI API key (used as fallback when Gemini hits quota/timeout) - optional
OPENAI_API_KEY=your_openai_api_key_here

# Optional tuning (seconds). Defaults are used if unset.
MODEL_TIMEOUT_SECONDS=300
KUNDLI_MODEL_TIMEOUT_SECONDS=300

# Backend port (default 8010; frontend expects 8010 unless REACT_APP_API_URL is set)
PORT=8010

# Auth token signing secret. Set a long random value so users stay logged in
# across server restarts. If unset, a random per-process secret is used.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET_KEY=

# Optional: auth token lifetime in seconds (default 2592000 = 30 days)
AUTH_TOKEN_TTL_SECONDS=2592000
